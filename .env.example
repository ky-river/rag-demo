OPENAI_API_KEY=填写你的百炼API_KEY
OPENAI_BASE_URL=https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
APP_VERSION=1.5
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=1
LOG_LEVEL=INFO

# 单实例滑动窗口限流；设为 0 可关闭对应配额。
AUTH_RATE_LIMIT_PER_MINUTE=10
MODEL_RATE_LIMIT_PER_MINUTE=30
WRITE_RATE_LIMIT_PER_MINUTE=10

# 可选 Cross-Encoder 重排。默认关闭，失败时自动回退到 RRF。
ENABLE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
RERANK_CANDIDATES=4
RERANK_CACHE_DIR=.cache/fastembed
